// Presentacion Final — Reconversion de Cultivos en Sonora
// Seminario de Inteligencia Artificial 2026
// Tema Claro y Visualización Optimizada de Imágenes

#set page(
  paper: "presentation-16-9",
  margin: (x: 1.2cm, top: 1.0cm, bottom: 1.2cm),
  fill: rgb("#f8fafc"),
  footer: context {
    let page-num = counter(page).get().first()
    if page-num > 1 {
      set text(size: 10pt, fill: rgb("#475569"))
      grid(
        columns: (1fr, 1fr),
        align(left)[Reconversión de Cultivos en Sonora], align(right)[#page-num / 22],
      )
    }
  },
)

#set text(
  font: "Nimbus Sans",
  size: 14pt,
  fill: rgb("#1e293b"),
  lang: "es",
)

#let slide(title, body) = {
  pagebreak(weak: true)
  grid(
    columns: (1fr, auto),
    align(left + horizon)[
      #text(20pt, weight: "bold", fill: rgb("#047857"))[#title]
    ],
    align(right + horizon)[
      #text(10pt, fill: rgb("#64748b"))[Seminario IA 2026]
    ],
  )
  v(-0.3em)
  line(length: 100%, stroke: 1.5pt + rgb("#059669"))
  v(0.4em)

  body
}

